{
  "name": "gp-connect",
  "productName": "GP Connect",
  "version": "0.2.0",
  "description": "Cross-platform GlobalProtect VPN client (Windows, macOS, Linux) built on OpenConnect",
  "author": {
    "name": "GP Connect contributors",
    "email": "gp-connect@users.noreply.github.com"
  },
  "homepage": "https://github.com/alexindacomp/GP-client",
  "repository": "github:alexindacomp/GP-client",
  "bugs": {
    "url": "https://github.com/alexindacomp/GP-client/issues"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run prepare:helper && tauri dev",
    "build": "npm run prepare:helper && tauri build",
    "dist:win": "npm run fetch:openconnect:win && npm run prepare:helper && tauri build --bundles nsis",
    "dist:mac": "tauri build --bundles dmg",
    "dist:linux": "tauri build --bundles deb,appimage",
    "tauri": "tauri",
    "dev:renderer": "vite --config vite.renderer.config.mts",
    "build:renderer": "vite build --config vite.renderer.config.mts",
    "preview:web": "vite --config src/renderer/preview/vite.config.mjs",
    "prepare:helper": "node scripts/prepare-helper.mjs",
    "fetch:openconnect:win": "node scripts/fetch-openconnect-win.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
