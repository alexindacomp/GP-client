{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["vite.renderer.config.mts", "vitest.config.mts", "src/shared/**/*"],
  "exclude": ["src/shared/window-gp.d.ts"]
}
