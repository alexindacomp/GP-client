{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GP Connect",
  "mainBinaryName": "gp-connect",
  "version": "../package.json",
  "identifier": "com.gpconnect.client",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist-renderer",
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "GP Connect",
        "width": 380,
        "height": 600,
        "minWidth": 360,
        "minHeight": 520,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "visible": false,
        "center": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "publisher": "GP Connect contributors",
    "copyright": "Copyright © GP Connect contributors",
    "category": "Utility",
    "shortDescription": "GlobalProtect VPN client (OpenConnect)",
    "longDescription": "Cross-platform GlobalProtect VPN client built on OpenConnect.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "template": "windows/installer.nsi"
      }
    },
    "linux": {
      "deb": {
        "depends": ["openconnect", "libwebkit2gtk-4.1-0", "policykit-1 | pkexec"],
        "section": "net",
        "files": {
          "/usr/share/polkit-1/actions/com.gpconnect.openconnect.policy": "../build/linux/com.gpconnect.openconnect.policy",
          "/usr/lib/gp-connect/com.gpconnect.openconnect.policy": "../build/linux/com.gpconnect.openconnect.policy"
        },
        "postInstallScript": "../build/linux/postinst.sh"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
