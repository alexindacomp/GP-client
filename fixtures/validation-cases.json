        "message": "The change was not confirmed",
        "text": "[code:not_confirmed] The change was not confirmed"
      },
      {
        "field": "name",
        "message": "x",
        "text": "[field:name] x"
      },
      {
        "message": "boom",
        "text": "boom"
      }
    ],
    "parse": [
      {
        "text": "[field:extraArgs][code:not_allowed] Option \"--x\" is not allowed.",
        "expected": {
          "field": "extraArgs",
          "code": "not_allowed",
          "message": "Option \"--x\" is not allowed."
        }
      },
      {
        "text": "Error invoking remote method 'gp:settings:set': Error: [code:not_confirmed] The change was not confirmed",
        "expected": {
          "code": "not_confirmed",
          "message": "The change was not confirmed"
        }
      },
      {
        "text": "Error invoking remote method 'gp:settings:set': ValidationError: [field:theme][code:invalid] Bad",
        "expected": {
          "field": "theme",
          "code": "invalid",
          "message": "Bad"
        }
      },
      {
        "text": "boom",
        "expected": {
          "message": "boom"
        }
      },
      {
        "text": "[code:internal] Internal error, see the log for details",
        "expected": {
          "code": "internal",
          "message": "Internal error, see the log for details"
        }
      }
    ]
